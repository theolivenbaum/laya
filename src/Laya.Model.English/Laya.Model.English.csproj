<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Laya</RootNamespace>
    <AssemblyName>Laya.Model.English</AssemblyName>
    <PackageId>Laya.Model.English</PackageId>
    <Title>Laya — English checkpoint</Title>
    <Description>The English Laya decision checkpoint (ModernBERT-large, 421M parameters, 512 tokens). Config and tokenizer ship in the package; the 843 MB weights file is downloaded once on first use.</Description>
    <PackageTags>$(PackageTags);english;checkpoint;model</PackageTags>
    <LayaCheckpointName>english</LayaCheckpointName>
    <LayaCheckpointSubfolder></LayaCheckpointSubfolder>
  </PropertyGroup>
  <Import Project="../LayaModelPackage.props" />
</Project>
