<Project>
  <!-- Shared by the three checkpoint packages (Laya.Model.English, .Multilingual,
       .TypedDecisions). Each of them sets:

         LayaCheckpointName        english | multilingual | typed-decisions
         LayaCheckpointSubfolder   the checkpoint's path inside the bundle repo ('' for english)

       and gets: the four non-weight checkpoint files fetched once into artifacts/ and embedded
       into the package assembly as resources named 'laya/checkpoint/<relative path>'.
       `model.safetensors` is deliberately *not* embedded — at 600-850 MB it belongs on a
       static host, and PackagedCheckpoint downloads it into the user's cache on first use. -->

  <PropertyGroup>
    <!-- A single-value TargetFrameworks still makes the project cross-targeting, which
         `dotnet run` then refuses; the single-target case sets the singular property instead. -->
    <TargetFramework Condition="'$(LayaEnableNet11)' != 'true'">net10.0</TargetFramework>
    <TargetFrameworks Condition="'$(LayaEnableNet11)' == 'true'">$(LayaTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>

    <!-- Where the checkpoint's small files are cached between builds (gitignored). -->
    <LayaCheckpointAssetDir Condition="'$(LayaCheckpointAssetDir)' == ''">$(MSBuildThisFileDirectory)../artifacts/checkpoint-assets/$(LayaCheckpointName)/</LayaCheckpointAssetDir>
    <!-- Where they are fetched from when the cache is cold. The Hugging Face repository is the
         published source of the checkpoints; point this at a mirror with -p:LayaCheckpointSourceUrl=. -->
    <LayaCheckpointSourceUrl Condition="'$(LayaCheckpointSourceUrl)' == ''">https://huggingface.co/convaiinnovations/laya/resolve/main/</LayaCheckpointSourceUrl>
    <LayaCheckpointPrefix Condition="'$(LayaCheckpointSubfolder)' != ''">$(LayaCheckpointSubfolder)/</LayaCheckpointPrefix>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)Laya/Laya.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rel is kept as metadata rather than read off the identity: on Windows an Include of
         'encoder/config.json' comes back with a backslash, and the resource name must not. -->
    <LayaCheckpointFile Include="rl_agent_config" Rel="rl_agent_config.json" />
    <LayaCheckpointFile Include="encoder_config" Rel="encoder/config.json" />
    <LayaCheckpointFile Include="tokenizer" Rel="tokenizer/tokenizer.json" />
    <LayaCheckpointFile Include="tokenizer_config" Rel="tokenizer/tokenizer_config.json" />
  </ItemGroup>

  <Target Name="FetchLayaCheckpointFiles" BeforeTargets="BeforeBuild">
    <!-- Only the missing ones: a warm artifacts/ cache builds and packs offline. -->
    <DownloadFile SourceUrl="$(LayaCheckpointSourceUrl)$(LayaCheckpointPrefix)%(LayaCheckpointFile.Rel)"
                  DestinationFolder="$(LayaCheckpointAssetDir)$([System.IO.Path]::GetDirectoryName('%(LayaCheckpointFile.Rel)'))"
                  DestinationFileName="$([System.IO.Path]::GetFileName('%(LayaCheckpointFile.Rel)'))"
                  Condition="!Exists('$(LayaCheckpointAssetDir)%(LayaCheckpointFile.Rel)')"
                  Retries="4"
                  RetryDelayMilliseconds="2000" />

    <Error Condition="!Exists('$(LayaCheckpointAssetDir)%(LayaCheckpointFile.Rel)')"
           Text="Checkpoint file '%(LayaCheckpointFile.Rel)' for '$(LayaCheckpointName)' is missing and could not be downloaded from $(LayaCheckpointSourceUrl)$(LayaCheckpointPrefix)%(LayaCheckpointFile.Rel)." />

    <ItemGroup>
      <EmbeddedResource Include="$(LayaCheckpointAssetDir)%(LayaCheckpointFile.Rel)"
                        LogicalName="laya/checkpoint/%(LayaCheckpointFile.Rel)" />
    </ItemGroup>
  </Target>
</Project>
