<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A single-value TargetFrameworks still makes the project cross-targeting, which
         `dotnet run` then refuses; the single-target case sets the singular property instead. -->
    <TargetFramework Condition="'$(LayaEnableNet11)' != 'true'">net10.0</TargetFramework>
    <TargetFrameworks Condition="'$(LayaEnableNet11)' == 'true'">$(LayaTargetFrameworks)</TargetFrameworks>
    <RootNamespace>StructuredDecisions</RootNamespace>
    <AssemblyName>StructuredDecisions.Base</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>StructuredDecisions.Base</PackageId>
    <Description>The shared base of the StructuredDecisions models: the decision-model interface, typed questions and answers, and the managed runtime they run on — SIMD GEMM kernels (fp32 and bf16), Hugging Face tokenizers, safetensors and checkpoint downloads.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Tokenizers/UnicodeNfc.data" LogicalName="StructuredDecisions.Tokenizers.UnicodeNfc.data" />
  </ItemGroup>
</Project>
