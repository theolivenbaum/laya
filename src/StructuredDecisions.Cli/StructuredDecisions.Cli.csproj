<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- A single-value TargetFrameworks still makes the project cross-targeting, which
         `dotnet run` then refuses; the single-target case sets the singular property instead. -->
    <TargetFramework Condition="'$(LayaEnableNet11)' != 'true'">net10.0</TargetFramework>
    <TargetFrameworks Condition="'$(LayaEnableNet11)' == 'true'">$(LayaTargetFrameworks)</TargetFrameworks>
    <RootNamespace>StructuredDecisions.Cli</RootNamespace>
    <!-- The command keeps its short name: `laya <command>` runs every model family. -->
    <AssemblyName>laya</AssemblyName>
    <PackAsTool>false</PackAsTool>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../StructuredDecisions.Laya/StructuredDecisions.Laya.csproj" />
    <ProjectReference Include="../StructuredDecisions.Laya.Catalyst/StructuredDecisions.Laya.Catalyst.csproj" />
    <ProjectReference Include="../StructuredDecisions.Laya.Training/StructuredDecisions.Laya.Training.csproj" />
    <ProjectReference Include="../StructuredDecisions.Mica/StructuredDecisions.Mica.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- `laya profile` captures a sampling profile and an allocation report of its own process. -->
    <PackageReference Include="Memory.Introspect" Version="26.9.5437" />
  </ItemGroup>
</Project>
