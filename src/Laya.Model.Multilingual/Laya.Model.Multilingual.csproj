<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Laya</RootNamespace>
    <AssemblyName>Laya.Model.Multilingual</AssemblyName>
    <PackageId>Laya.Model.Multilingual</PackageId>
    <Title>Laya — multilingual checkpoint</Title>
    <Description>The multilingual Laya decision checkpoint (mmBERT-base, 322M parameters, 1024 tokens, 100+ languages). Config and tokenizer ship in the package; the 644 MB weights file is downloaded once on first use.</Description>
    <PackageTags>$(PackageTags);multilingual;checkpoint;model</PackageTags>
    <LayaCheckpointName>multilingual</LayaCheckpointName>
    <LayaCheckpointSubfolder>multilingual</LayaCheckpointSubfolder>
  </PropertyGroup>
  <Import Project="../LayaModelPackage.props" />
</Project>
