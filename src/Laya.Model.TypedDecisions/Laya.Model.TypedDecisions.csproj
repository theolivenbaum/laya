<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Laya</RootNamespace>
    <AssemblyName>Laya.Model.TypedDecisions</AssemblyName>
    <PackageId>Laya.Model.TypedDecisions</PackageId>
    <Title>Laya — typed-decisions checkpoint</Title>
    <Description>The typed-decisions Laya checkpoint (ModernBERT-large, 421M parameters, 1024 tokens). Config and tokenizer ship in the package; the 843 MB weights file is downloaded once on first use.</Description>
    <PackageTags>$(PackageTags);typed-decisions;checkpoint;model</PackageTags>
    <LayaCheckpointName>typed-decisions</LayaCheckpointName>
    <LayaCheckpointSubfolder>typed-decisions</LayaCheckpointSubfolder>
  </PropertyGroup>
  <Import Project="../LayaModelPackage.props" />
</Project>
