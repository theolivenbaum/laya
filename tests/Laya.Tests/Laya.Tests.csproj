<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Laya.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" LinkBase="Fixtures" />
    <!-- A stand-in for a checkpoint package's payload, so PackagedCheckpoint can be exercised
         end to end (extract + weights download) without an 800 MB file. -->
    <EmbeddedResource Include="Fixtures/packaged/rl_agent_config.json" LogicalName="laya/checkpoint/rl_agent_config.json" />
    <EmbeddedResource Include="Fixtures/packaged/tokenizer/tokenizer.json" LogicalName="laya/checkpoint/tokenizer/tokenizer.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Laya/Laya.csproj" />
    <!-- The checkpoint packages are tested for their embedded payload, not for their weights. -->
    <ProjectReference Include="../../src/Laya.Model.English/Laya.Model.English.csproj" />
    <ProjectReference Include="../../src/Laya.Model.Multilingual/Laya.Model.Multilingual.csproj" />
    <ProjectReference Include="../../src/Laya.Model.TypedDecisions/Laya.Model.TypedDecisions.csproj" />
  </ItemGroup>
</Project>
