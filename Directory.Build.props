<Project>
  <!-- The port targets .NET 10 and .NET 11: .NET 11 ships a handful of extra
       Vector/TensorPrimitives methods we use behind #if NET11_0_OR_GREATER. The repository
       must still build on a .NET 10 SDK, so the net11.0 target is only added when an 11.x
       SDK is actually installed. Force it either way with -p:LayaEnableNet11=true|false. -->
  <PropertyGroup>
    <LayaDotnetRoot Condition="'$(LayaDotnetRoot)' == ''">$(MSBuildExtensionsPath)</LayaDotnetRoot>
    <!-- MSBuildExtensionsPath is the running SDK's own folder, e.g. /usr/lib/dotnet/sdk/10.0.112,
         so its parent is where every installed SDK version lives. -->
    <LayaSdkDir>$([System.IO.Path]::GetFullPath('$(LayaDotnetRoot)/..'))</LayaSdkDir>
    <LayaEnableNet11 Condition="'$(LayaEnableNet11)' == '' And $([System.IO.Directory]::Exists('$(LayaSdkDir)')) And $([System.IO.Directory]::GetDirectories('$(LayaSdkDir)', '11.*').Length) &gt; 0">true</LayaEnableNet11>
    <LayaEnableNet11 Condition="'$(LayaEnableNet11)' == ''">false</LayaEnableNet11>

    <LayaTargetFrameworks>net10.0</LayaTargetFrameworks>
    <LayaTargetFrameworks Condition="'$(LayaEnableNet11)' == 'true'">net10.0;net11.0</LayaTargetFrameworks>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- CI stamps a CalVer version (-p:Version=yy.M.<run>) across every package in a run; this
         is what a local `dotnet pack` produces instead. -->
    <Version>0.3.3</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Package metadata shared by Laya and the three checkpoint packages. -->
  <PropertyGroup>
    <Authors>Curiosity GmbH, Convai Innovations</Authors>
    <Company>Curiosity GmbH</Company>
    <Product>Laya</Product>
    <Copyright>(c) Copyright 2026 Curiosity GmbH - all rights reserved, Copyright (c) 2025 Convai Innovations (Laya)</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/theolivenbaum/laya</PackageProjectUrl>
    <RepositoryUrl>https://github.com/theolivenbaum/laya</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>laya;nlp;classification;routing;decision;modernbert;transformer;onnx-free;simd;cpu</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML comments on public members are documentation debt, not build errors. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <!-- Source Link: deterministic builds with sources resolvable from GitHub, and a .snupkg
         of symbols so a stack trace through Laya lands on real code. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
